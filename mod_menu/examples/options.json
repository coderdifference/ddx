{
  "version": 1,
  "id": "example.expedition",
  "title": "Expedition Settings",
  "fields": [
    { "id": "name", "label": "Journal title", "type": "text", "default": "The Estate", "maxLength": 80 },
    { "id": "limit", "label": "Entries per week", "type": "integer", "default": 20, "min": 1, "max": 1000 },
    { "id": "scale", "label": "Notification duration", "type": "float", "default": 1.5, "min": 0.1, "max": 10 },
    { "id": "detail", "label": "Detail level", "type": "enum", "default": "normal", "choices": [{ "id": "short", "label": "Brief" }, { "id": "normal", "label": "Normal" }, { "id": "full", "label": "Full" }] },
    { "id": "sound", "label": "Notification sound", "type": "single", "default": "quiet", "choices": [{ "id": "quiet", "label": "Quiet bell" }, { "id": "loud", "label": "Loud bell" }] },
    { "id": "events", "label": "Tracked events", "type": "multi", "default": ["quests"], "choices": [{ "id": "quests", "label": "Quests" }, { "id": "heroes", "label": "Heroes" }, { "id": "loot", "label": "Loot" }] }
  ]
}
